SYCL_ENV=development
SYCL_SECRET_KEY=replace-with-a-long-random-value
SYCL_DATABASE_PATH=./data/training_garden.db
SYCL_STORAGE_PATH=./storage
SYCL_CORS_ORIGINS=http://localhost:5173
SYCL_TOKEN_TTL_MINUTES=720
SYCL_INSTANCE_TTL_MINUTES=60
SYCL_INSTANCE_PUBLIC_HOST=localhost
# Host interface that publishes challenge ports: keep 127.0.0.1 unless players connect directly.
SYCL_INSTANCE_BIND_ADDRESS=127.0.0.1
# Optional fixed port window for challenge containers; leave empty to let Docker choose.
SYCL_INSTANCE_PORT_RANGE_START=
SYCL_INSTANCE_PORT_RANGE_END=
SYCL_INSTANCE_REAPER_ENABLED=true
SYCL_FLAG_PREFIX=SYC
# Optional absolute platform URL, e.g. https://training.example.com
SYCL_PUBLIC_BASE_URL=
# Return the instance immediately and start the container in the background
SYCL_INSTANCE_START_ASYNC=true
SYCL_INSTANCE_REAPER_INTERVAL_SECONDS=60
SYCL_DOCKER_MODE=cli
SYCL_SEED_DEMO=true
SYCL_ADMIN_USERNAME=admin
SYCL_ADMIN_PASSWORD=Syclover@2026
SYCL_MAX_UPLOAD_BYTES=10485760
SYCL_MAX_BUILD_UPLOAD_BYTES=134217728
